APP_NAME="Gestión de Visitas MINC"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api-visitas-backend.azurewebsites.net

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=visitas_db
DB_USERNAME=root
DB_PASSWORD=

# JWT (generar con: php artisan jwt:secret)
JWT_SECRET=
JWT_ALGO=HS256
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_ENABLED=true

# Cache y sesiones
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Redis (opcional — si se habilita cache/queue via Redis)
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=null

# CORS — dominio del frontend
SANCTUM_STATEFUL_DOMAINS=visitas-frontend.azurewebsites.net
